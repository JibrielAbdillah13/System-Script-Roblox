-- refreshTabs dideklarasikan SEBELUM doPlay agar bisa dipanggil di dalam doPlay
local function refreshTabs()
	for _, g in ipairs(genres) do
		local b = tabBtns[g]
		if g == State.genre then
			b.BackgroundColor3       = C.green
			b.BackgroundTransparency = 0
			b.TextColor3             = C.white
		else
			b.BackgroundColor3       = C.panel
			b.BackgroundTransparency = 0.1
			b.TextColor3             = C.greenD
		end
	end
end

local function refreshSongList()
	for _, v in ipairs(songItems) do v:Destroy() end
	songItems = {}

	local pl = Playlists[State.genre]
	for i, song in ipairs(pl) do
		local active = (State.playingGenre == State.genre) and (i == State.playingIndex)
		local row = Instance.new("TextButton")
		row.Size                 = UDim2.new(1,0,0,36)
		row.BackgroundColor3     = active and C.green or C.white
		row.BackgroundTransparency = active and 0 or 0.35
		row.Text                 = (active and "▶  " or "    ") .. i .. ".  " .. song.name
		row.Font                 = active and Enum.Font.GothamBold or Enum.Font.Gotham
		row.TextSize             = 12
		row.TextColor3           = active and C.white or C.greenD
		row.TextXAlignment       = Enum.TextXAlignment.Left
		row.BorderSizePixel      = 0
		row.LayoutOrder          = i
		row.ZIndex               = 7
		row.Parent               = SongScroll
		Instance.new("UICorner", row).CornerRadius = UDim.new(0,7)
		local rp = Instance.new("UIPadding", row)
		rp.PaddingLeft = UDim.new(0,8)
		table.insert(songItems, row)

		local idx = i
		row.MouseButton1Click:Connect(function()
			if State.index ~= idx then
				State.index = idx
				if State.sound then
					State.sound:Stop()
					State.sound:Destroy()
					State.sound = nil
				end
				State.playing = false
			elseif State.playing and State.playingGenre == State.genre then
				return
			end
			doPlay()
		end)

		row.MouseEnter:Connect(function()
			local isActive = (State.playingGenre == State.genre) and (idx == State.playingIndex)
			if not isActive then
				row.BackgroundColor3 = C.panel ; row.BackgroundTransparency = 0
			end
		end)
		row.MouseLeave:Connect(function()
			local isActive = (State.playingGenre == State.genre) and (idx == State.playingIndex)
			if not isActive then
				row.BackgroundColor3 = C.white ; row.BackgroundTransparency = 0.35
			end
		end)
	end
end

local function setPlayIcon(isNowPlaying)
	if playBtn then
		playBtn.Image = isNowPlaying and Icons.pause or Icons.play
	end
end

local function doStop()
	State.playing      = false
	State.playingGenre = nil
	State.playingIndex = nil
	if State.sound then
		State.sound:Stop()
		State.sound:Destroy()
		State.sound = nil
	end
	setPlayIcon(false)
	resetDuration()
	NowLbl.Text          = "Dihentikan"
	StatusLbl.Text       = "⏹  Dihentikan"
	StatusLbl.TextColor3 = Color3.fromRGB(255,200,200)
	refreshSongList()
end

local function doPause()
	if State.sound and State.playing then
		State.sound:Pause()
		State.playing = false
		setPlayIcon(false)
		StatusLbl.Text = "⏸  Dijeda"
		refreshSongList()
	end
end

-- ============================================================
-- doPlay - FUNGSI UTAMA
-- ============================================================
doPlay = function()
	if State.sound and not State.playing then
		State.sound:Resume()
		State.playing = true
		setPlayIcon(true)
		local pl = Playlists[State.genre]
		StatusLbl.Text       = "▶  " .. (pl[State.index] and pl[State.index].name or "?")
		StatusLbl.TextColor3 = C.white
		State.playingGenre   = State.genre
		State.playingIndex   = State.index
		refreshSongList()
		return
	end

	if State.sound then
		State.sound:Stop()
		State.sound:Destroy()
		State.sound = nil
	end

	State.playing = false
	resetDuration()

	local pl   = Playlists[State.genre]
	local song = pl[State.index]
	if not song then return end

	local snd = Instance.new("Sound")
	snd.SoundId = "rbxassetid://" .. tostring(song.id)
	snd.Volume  = State.volume
	snd.Parent  = SoundService
	State.sound = snd

	snd.Loaded:Wait()
	snd:Play()
	State.playing      = true
	State.playingGenre = State.genre
	State.playingIndex = State.index
	setPlayIcon(true)

	DurationLbl.Text     = "00:00 / " .. formatTime(snd.TimeLength)
	NowLbl.Text          = song.name
	StatusLbl.Text       = "▶  " .. song.name
	StatusLbl.TextColor3 = C.white

	refreshSongList()

	local thisSnd = snd  -- simpan referensi lokal
	snd.Ended:Connect(function()
		if State.sound ~= thisSnd then return end

		local finishedGenre = State.playingGenre
		local finishedIndex = State.playingIndex

		State.playing      = false
		State.playingGenre = nil
		State.playingIndex = nil
		State.sound        = nil  -- ← TAMBAH INI, clear sound dulu
		setPlayIcon(false)
		resetDuration()

		if State.looping then
			task.wait(0.2)
			State.genre = finishedGenre
			State.index = finishedIndex
			refreshTabs()
			doPlay()
		else
			task.wait(0.4)
			if not finishedGenre then return end  -- safety check
			local pl2 = Playlists[finishedGenre]
			State.genre = finishedGenre
			State.index = finishedIndex % #pl2 + 1
			refreshTabs()
			refreshSongList()
			doPlay()
		end
	end)
end
    
	
-- ============================================================
-- FUNGSI NAVIGASI
-- ============================================================
local function doNext()
	local pl = Playlists[State.genre]
	State.index = State.index % #pl + 1
	refreshSongList()
	doPlay()
end

local function doPrev()
	local pl = Playlists[State.genre]
	State.index = ((State.index - 2) % #pl) + 1
	refreshSongList()
	doPlay()
end

local function doPlaylist()
	State.playlist = true
	State.index    = 1
	refreshSongList()
	doPlay()
end

local function doRandom()
	State.playlist = true
	State.index    = math.random(1, #Playlists[State.genre])
	refreshSongList()
	doPlay()
end

