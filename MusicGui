local function mkFrame(parent, size, pos, bg, bgTrans, zIdx, radius)
	local f = Instance.new("Frame")
	f.Size = size ; f.Position = pos
	f.BackgroundColor3 = bg ; f.BackgroundTransparency = bgTrans
	f.BorderSizePixel = 0 ; f.ZIndex = zIdx ; f.Parent = parent
	Instance.new("UICorner", f).CornerRadius = UDim.new(0, radius or 0)
	return f
end

local function mkStroke(parent, color, thick, trans)
	local s = Instance.new("UIStroke", parent)
	s.Color = color ; s.Thickness = thick ; s.Transparency = trans or 0
	return s
end

local function formatTime(secs)
	if secs ~= secs or secs < 0 then secs = 0 end
	local s = math.floor(secs)
	return string.format("%02d:%02d", math.floor(s / 60), s % 60)
end

