local function getAvailablePos(teamTable, maxPos)
	local taken = {}
	for _, idx in pairs(teamTable) do taken[idx] = true end
	for _, i in ipairs(POS_ORDER) do
		if i <= maxPos and not taken[i] then return i end
	end
	for i = 1, maxPos do
		if not taken[i] then return i end
	end
	return nil
end

local function resetRope()
	taliSebelum.Transparency = 0
	taliSesudah.Transparency = 1
	tugValue = 0
	updateBarEvent:FireAllClients(tugValue)
	
	local bg = taliSesudah:FindFirstChild("TarikTambangBillboard")
	if bg then bg.Enabled = false end
end

local function getTeamCount(teamTable)
	local c = 0
	for _, _ in pairs(teamTable) do c = c + 1 end
	return c
end

local function broadcastState()
	for _, p in ipairs(Players:GetPlayers()) do
		local isPart = (redPlayers[p] ~= nil) or (whitePlayers[p] ~= nil)
		updateStateEvent:FireClient(p, GAME_STATE, getTeamCount(redPlayers), getTeamCount(whitePlayers), isPart)
	end
end

local function setGameState(newState)
	GAME_STATE = newState
	broadcastState()
	
	if newState == "PLAYING" then
		taliSebelum.Transparency = 1
		taliSesudah.Transparency = 0
		local bg = taliSesudah:FindFirstChild("TarikTambangBillboard")
		if bg then bg.Enabled = true end
	elseif newState == "WAITING" then
		resetRope()
	end
end

local function cleanPlayer(player)
	if playerDeathConns[player] then
		playerDeathConns[player]:Disconnect()
		playerDeathConns[player] = nil
	end
	if playerAnimations[player] then
		pcall(function()
			playerAnimations[player]:Stop()
		end)
		playerAnimations[player] = nil
	end
	if playerOriginalStates[player] then
		local char = player.Character
		-- hanya pulihkan jika karakternya masih sama (bukan hasil respawn baru)
		if char and char == playerOriginalStates[player].Char then
			local hum = char:FindFirstChild("Humanoid")
			if hum and hum.Health > 0 then
				hum.WalkSpeed = playerOriginalStates[player].WalkSpeed
				hum.JumpPower = playerOriginalStates[player].JumpPower
				hum.JumpHeight = playerOriginalStates[player].JumpHeight
				hum.UseJumpPower = playerOriginalStates[player].UseJumpPower
			end
			local hrp = char:FindFirstChild("HumanoidRootPart")
			if hrp and playerOriginalStates[player].CFrame and hum and hum.Health > 0 then
				hrp.CFrame = playerOriginalStates[player].CFrame
			end
		end
		playerOriginalStates[player] = nil
	end
	redPlayers[player] = nil
	whitePlayers[player] = nil
	playerCombos[player] = nil
end

local countdownActive = false
local function checkStart()
	if GAME_STATE == "WAITING" and getTeamCount(redPlayers) > 0 and getTeamCount(whitePlayers) > 0 and not countdownActive then
		countdownActive = true
		setGameState("COUNTDOWN")
		for i = 5, 1, -1 do
			if getTeamCount(redPlayers) == 0 or getTeamCount(whitePlayers) == 0 then
				countdownActive = false
				setGameState("WAITING")
				return
			end
			task.wait(1)
		end
		countdownActive = false
		if getTeamCount(redPlayers) > 0 and getTeamCount(whitePlayers) > 0 then
			setGameState("PLAYING")
		else
			setGameState("WAITING")
		end
	end
end

local function addPlayerToTeam(player, teamName)
	if GAME_STATE ~= "WAITING" and GAME_STATE ~= "COUNTDOWN" then return end
	if redPlayers[player] or whitePlayers[player] then return end
	
	local char = player.Character
	if not char or not char:FindFirstChild("HumanoidRootPart") then return end
	
	local teamTable = teamName == "RED" and redPlayers or whitePlayers
	local currentPosList = teamName == "RED" and tarikFolder:FindFirstChild("POSISI TIM MERAH"):GetChildren() or tarikFolder:FindFirstChild("POSISI TIM PUTIH"):GetChildren()
	
	local posIdx = getAvailablePos(teamTable, #currentPosList)
	if not posIdx then return end
	
	teamTable[player] = posIdx
	local targetPart = currentPosList[posIdx]
	
	local baseCF
	if teamName == "RED" then
		baseCF = targetPart.CFrame * CFrame.Angles(0, math.pi, 0) * CFrame.new(0, 3, 0)
	else
		baseCF = targetPart.CFrame * CFrame.new(0, 3, 0)
	end
	
	local hum = char:FindFirstChild("Humanoid")
	if hum then
		playerOriginalStates[player] = {
			Char = char,
			WalkSpeed = hum.WalkSpeed,
			JumpPower = hum.JumpPower,
			JumpHeight = hum.JumpHeight,
			UseJumpPower = hum.UseJumpPower,
			CFrame = char.HumanoidRootPart.CFrame,
			BaseCFrame = baseCF
		}
		hum.WalkSpeed = 0
		hum.JumpPower = 0
		hum.JumpHeight = 0
		hum.UseJumpPower = true
		
		-- Jika player mati saat masih ikut tarik tambang, lepas dia dari tim
		playerDeathConns[player] = hum.Died:Connect(function()
			handlePlayerGone(player)
		end)
		
		if ANIMATION_ID and ANIMATION_ID ~= "" then
			pcall(function()
				local anim = Instance.new("Animation")
				anim.AnimationId = ANIMATION_ID
				local animator = hum:FindFirstChildOfClass("Animator") or hum:WaitForChild("Animator", 2)
				local track
				if animator then
					track = animator:LoadAnimation(anim)
				else
					track = hum:LoadAnimation(anim)
				end
				track.Priority = Enum.AnimationPriority.Action4
				track.Looped = true
				track:Play()
				playerAnimations[player] = track
			end)
		end
	end
	
	char.HumanoidRootPart.CFrame = baseCF
	
	broadcastState()
	checkStart()
end

local function handleGameOver(winnerTeam)
	if GAME_STATE == "GAMEOVER" then return end -- cegah pemanggilan ganda
	setGameState("GAMEOVER")
	local losers = winnerTeam == "RED" and whitePlayers or redPlayers
	
	local kalahPart = kalahModel:FindFirstChildWhichIsA("BasePart")
	
	for p, _ in pairs(losers) do
		local char = p.Character
		if char and char:FindFirstChild("HumanoidRootPart") and kalahPart then
			TweenService:Create(char.HumanoidRootPart, TweenInfo.new(1.5, Enum.EasingStyle.Sine, Enum.EasingDirection.Out), {
				CFrame = kalahPart.CFrame * CFrame.new(0, 5, 0)
			}):Play()
		end
	end
	
	task.wait(4)
	
	for p, _ in pairs(redPlayers) do cleanPlayer(p) end
	for p, _ in pairs(whitePlayers) do cleanPlayer(p) end
	
	setGameState("WAITING")
end

-- Dipanggil saat player mati atau keluar game saat masih terdaftar di tim.
-- Memastikan tarik tambang selalu kembali bisa digunakan.
handlePlayerGone = function(player)
	local wasInGame = (redPlayers[player] ~= nil) or (whitePlayers[player] ~= nil)
	cleanPlayer(player)
	if wasInGame then
		broadcastState()
	end
	if GAME_STATE == "PLAYING" then
		local redCount = getTeamCount(redPlayers)
		local whiteCount = getTeamCount(whitePlayers)
		if redCount == 0 and whiteCount == 0 then
			-- semua player hilang, kembalikan ke WAITING agar arena bisa dipakai lagi
			setGameState("WAITING")
		elseif redCount == 0 then
			handleGameOver("WHITE")
		elseif whiteCount == 0 then
			handleGameOver("RED")
		end
	end
end

task.wait(2)
for _, prompt in ipairs(tarikFolder:GetDescendants()) do
	if prompt:IsA("ProximityPrompt") and prompt.Name == "TarikTambangPrompt" then
		prompt.RequiresLineOfSight = false
		prompt.Triggered:Connect(function(player)
