			elseif prompt.ObjectText == "Tim Putih" then
				addPlayerToTeam(player, "WHITE")
			end
		end)
	end
end

joinEvent.OnServerEvent:Connect(function(player, teamName)
	if teamName == "RED" or teamName == "WHITE" then
		addPlayerToTeam(player, teamName)
	end
end)

leaveEvent.OnServerEvent:Connect(function(player)
	if GAME_STATE == "WAITING" or GAME_STATE == "COUNTDOWN" then
		handlePlayerGone(player)
	end
end)

pullEvent.OnServerEvent:Connect(function(player, isHit)
	if GAME_STATE ~= "PLAYING" then return end
	if typeof(isHit) ~= "boolean" then return end -- validasi input dari client
	
	local power = 0
	if isHit then
		playerCombos[player] = (playerCombos[player] or 0) + 1
		local mult = math.min(playerCombos[player], 3)
		power = 3 * mult
	else
		playerCombos[player] = 0
		power = -3
	end
	
	if redPlayers[player] then
		tugValue = tugValue - power
	elseif whitePlayers[player] then
		tugValue = tugValue + power
	else
		return
	end
	
	if tugValue < -100 then tugValue = -100 end
	if tugValue > 100 then tugValue = 100 end
	
	updateBarEvent:FireAllClients(tugValue)
	
	local dragRatio = tugValue / 100
	local maxDragDistance = 15
	
	for p, idx in pairs(redPlayers) do
		local char = p.Character
		if char and char:FindFirstChild("HumanoidRootPart") and playerOriginalStates[p] then
			local baseCF = playerOriginalStates[p].BaseCFrame
			local targetCF = baseCF * CFrame.new(0, 0, -dragRatio * maxDragDistance)
			TweenService:Create(char.HumanoidRootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {CFrame = targetCF}):Play()
		end
	end
	
	for p, idx in pairs(whitePlayers) do
		local char = p.Character
		if char and char:FindFirstChild("HumanoidRootPart") and playerOriginalStates[p] then
			local baseCF = playerOriginalStates[p].BaseCFrame
			local targetCF = baseCF * CFrame.new(0, 0, dragRatio * maxDragDistance)
			TweenService:Create(char.HumanoidRootPart, TweenInfo.new(0.2, Enum.EasingStyle.Sine), {CFrame = targetCF}):Play()
		end
	end
	
	if tugValue <= -100 then
		handleGameOver("RED")
	elseif tugValue >= 100 then
		handleGameOver("WHITE")
	end
end)

Players.PlayerRemoving:Connect(function(player)
	handlePlayerGone(player)
end)

Players.PlayerAdded:Connect(function(player)
	local isPart = (redPlayers[player] ~= nil) or (whitePlayers[player] ~= nil)
	updateStateEvent:FireClient(player, GAME_STATE, getTeamCount(redPlayers), getTeamCount(whitePlayers), isPart)
end)

resetRope()

-- Safety net: kalau karakter player hilang tanpa memicu event Died
-- (misal di-destroy lewat cara lain), tetap dibersihkan agar game tidak stuck
task.spawn(function()
	while true do
		task.wait(2)
		if GAME_STATE == "PLAYING" then
			for _, p in ipairs(Players:GetPlayers()) do
				local char = p.Character
				local hum = char and char:FindFirstChildOfClass("Humanoid")
				if (redPlayers[p] or whitePlayers[p]) and (not char or not hum or hum.Health <= 0) then
					handlePlayerGone(p)
				end
			end
		end
	end
end)
