-- ============================================================
-- 🎬 LOCAL SCRIPT - CutScene Manager
-- Letakkan di: StarterPlayerScripts
-- ============================================================

local TweenService      = game:GetService("TweenService")
local Players           = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local player    = Players.LocalPlayer
local char      = player.Character or player.CharacterAdded:Wait()
local humanoid  = char:WaitForChild("Humanoid")
local cam       = workspace.CurrentCamera

--Hide GUI
local Backgui   = player:WaitForChild("PlayerGui"):WaitForChild("BackpackGui")

-- ============================================================
-- 📡 Tunggu RemoteEvents dari server
-- ============================================================
local remoteFolder = ReplicatedStorage:WaitForChild("CutsceneRemotes", 15)
if not remoteFolder then
	warn("❌ Folder CutsceneRemotes tidak ditemukan!")
	return
end

local remoteAwal   = remoteFolder:WaitForChild("StartCutSceneAwal", 15)
local remote1      = remoteFolder:WaitForChild("StartCutScene1",      15)
local remoteSummit = remoteFolder:WaitForChild("StartCutSceneSummit", 15)

if not remote1 or not remoteSummit then
	warn("❌ RemoteEvents tidak ditemukan!")
	return
end

-- ============================================================
-- 🛠️ HELPER UMUM
-- ============================================================
local function waitLongest(durationA, durationB)
	task.wait(math.max(durationA, durationB))
end

local function makeBars(guiName)
	local bh = 80

	local sg = Instance.new("ScreenGui")
	sg.Name            = guiName
	sg.ResetOnSpawn    = false
	sg.IgnoreGuiInset  = true
	sg.Parent          = player.PlayerGui

	local top = Instance.new("Frame")
	top.Name             = "TopBar"
	top.Size             = UDim2.new(1, 0, 0, bh)
	top.Position         = UDim2.new(0, 0, 0, -bh)
	top.BackgroundColor3 = Color3.new(0, 0, 0)
	top.BorderSizePixel  = 0
	top.Parent           = sg

	local bot = Instance.new("Frame")
	bot.Name             = "BottomBar"
	bot.Size             = UDim2.new(1, 0, 0, bh)
	bot.Position         = UDim2.new(0, 0, 1, 0)
	bot.BackgroundColor3 = Color3.new(0, 0, 0)
	bot.BorderSizePixel  = 0
	bot.Parent           = sg

	return sg, top, bot, bh
end

local function showBars(top, bot, bh)
	local info = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
	TweenService:Create(top, info, {Position = UDim2.new(0,0,0,0)}):Play()
	TweenService:Create(bot, info, {Position = UDim2.new(0,0,1,-bh)}):Play()
	task.wait(0.6)
end

local function hideBars(top, bot, bh)
	local info = TweenInfo.new(0.8, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
	TweenService:Create(top, info, {Position = UDim2.new(0,0,0,-bh)}):Play()
	TweenService:Create(bot, info, {Position = UDim2.new(0,0,1,0)}):Play()
	task.wait(0.8)
end
