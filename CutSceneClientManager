-- ╔══════════════════════════════════════════════════════════════╗
-- ║      🌲 CUTSCENE Awal - Welcome in Mount Daives (BASE)  	  ║
-- ╚══════════════════════════════════════════════════════════════╝

-- GUI CutSceneAwal (GUI di dalam StarterGui)
local screenGui, topBar, bottomBar, barHeight = makeBars("CinematicBars")

-- Sound CutSceneAwal (dibuat saat remote diterima, bukan saat load)
local sound1, sound2, ambruk

-- ============================================================
-- 📡 Terima sinyal dari server → jalankan CutScene1
-- Server mengirim: cam1, dustPart, particleEmitter
-- ============================================================
remote1.OnClientEvent:Connect(function(cam1, dustPart, particleEmitter)

	-- Setup sound (baru dibuat setelah objek cam1 & dustPart diterima dari server)
	if not sound1 then
		sound1 = cam1:FindFirstChildOfClass("Sound") or Instance.new("Sound", cam1)
		sound1.SoundId = "rbxassetid://96646052867948"  -- percakapan 1 (7 detik)
	end

	if not sound2 then
		sound2 = Instance.new("Sound", cam1)
		sound2.SoundId     = "rbxassetid://128926022108796"  -- percakapan 2 (6 detik)
		sound2.Volume      = 1
		sound2.RollOffMode = "Linear"
	end

	if not ambruk then
		ambruk = Instance.new("Sound", dustPart)
		ambruk.SoundId = "rbxassetid://9113384036"  -- suara pohon ambruk
		ambruk.Volume  = 1
	end

	print("▶ CutScene1 dimulai")

	-- 🔒 Bekukan player
	humanoid.WalkSpeed  = 0
	humanoid.JumpHeight = 0

	--Matikan sebentar backpack gui nya
	Backgui.Enabled = false

	ambruk:Play()
	showBars(topBar, bottomBar, barHeight)

	cam.CameraType = Enum.CameraType.Scriptable
	cam.CFrame     = cam1.CFrame
	particleEmitter.Enabled = true

	-- 🎥 Scene 1: zoom in
	local tween1Duration = 5
	local sound1Duration = 7
	local tween1 = TweenService:Create(cam,
		TweenInfo.new(tween1Duration, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{CFrame = cam1.CFrame + (cam1.CFrame.LookVector * 10)}
	)
	tween1:Play()
	sound1:Play()
	waitLongest(tween1Duration, sound1Duration)

	-- 🎥 Scene 2: putar -115°
	local rotated = cam.CFrame * CFrame.Angles(0, math.rad(-115), 0)
	local tween2 = TweenService:Create(cam,
		TweenInfo.new(6, Enum.EasingStyle.Sine, Enum.EasingDirection.InOut),
		{CFrame = rotated}
	)
	tween2:Play()
	task.wait(2)
	sound2:Play()
	task.wait(6)

	-- 🎬 Akhiri CutScene1
	print("✅ CutScene1 selesai")
	hideBars(topBar, bottomBar, barHeight)
	particleEmitter.Enabled = false
	cam.CameraType          = Enum.CameraType.Custom
	humanoid.WalkSpeed      = 16
	humanoid.JumpHeight     = 7.2

	task.wait(1)
	screenGui:Destroy()

	--Nyalakan lagi backpack gui nya
	Backgui.Enabled = true

end)

