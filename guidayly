LoginRemote.OnClientEvent:Connect(function(data)
	currentData = data
	updateCoinDisplay(data.coins)

	if data.justClaimed then
		-- Update kartu: hari yang baru diklaim → "done"
		updateDayCards(data.currentDay, false)

		-- Update tombol klaim langsung
		claimBtn.BackgroundColor3 = Color3.fromRGB(62, 93, 62)
		--claimBtn.Text             = "✓  Sudah Diklaim Hari Ini"
		claimBtn.Active           = false
		btnStroke.Color           = Color3.fromRGB(80, 140, 80)
		
		-- Mulai countdown setelah klaim
		if data.lastLogin then
			startCountdown(data.lastLogin)
		end
		
	else
		showLoginPanel(data)
		-- Kalau sudah diklaim sebelumnya, langsung jalankan countdown
		if not data.canClaim and data.lastLogin then
			startCountdown(data.lastLogin)
		end
		
	end
end)

