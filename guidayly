local dayCards = {}

local function makeCard(dayIndex, posX, posY, w, h)
	local isBig   = (w > CW)
	local hdrH    = isBig and 28 or HDR_H
	local iconSz  = isBig and COIN_BG or COIN_SM
	local badgeSz = isBig and BADGE_BG or BADGE_SM
	local rSz     = isBig and RTXT_BG or RTXT_SM

	-- Frame kartu
	local card             = Instance.new("Frame", panel)
	card.Name              = "DayCard"..dayIndex
	card.Size              = UDim2.new(0, w, 0, h)
	card.Position          = UDim2.new(0, posX, 0, posY)
	card.BackgroundColor3  = CARD_BG
	card.BorderSizePixel   = 0
	Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
	local cardS            = Instance.new("UIStroke", card)
	cardS.Thickness        = 1.5
	cardS.Color            = GOLD_DARK

	-- Header "Day N"
	local hdr              = Instance.new("Frame", card)
	hdr.Size               = UDim2.new(1, 0, 0, hdrH)
	hdr.BackgroundColor3   = PURPLE_MID
	hdr.BorderSizePixel    = 0
	Instance.new("UICorner", hdr).CornerRadius = UDim.new(0, 10)
	local hPatch           = Instance.new("Frame", hdr)
	hPatch.Size            = UDim2.new(1, 0, 0, 12)
	hPatch.Position        = UDim2.new(0, 0, 1, -12)
	hPatch.BackgroundColor3 = PURPLE_MID
	hPatch.BorderSizePixel  = 0

	local hTxt             = Instance.new("TextLabel", hdr)
	hTxt.Size              = UDim2.new(1, 0, 1, 0)
	hTxt.BackgroundTransparency = 1
	hTxt.Text              = "Day "..dayIndex
	hTxt.TextColor3        = WHITE
	hTxt.TextSize          = isBig and 16 or 14
	hTxt.Font              = Enum.Font.GothamBold

	-- Koin: tengah horizontal, tengah vertikal antara header & bawah kartu
	-- Sisa ruang vertikal di bawah header (dikurangi area bawah untuk teks+badge)
	local bottomAreaH = rSz + 10   -- tinggi area teks reward di bawah
	local midAreaTop  = hdrH + 4
	local midAreaH    = h - midAreaTop - bottomAreaH
	local coinOffY    = midAreaTop + math.floor((midAreaH - iconSz) / 2)
	if coinOffY < midAreaTop then coinOffY = midAreaTop end

	local coinImg          = Instance.new("ImageLabel", card)
	coinImg.Size           = UDim2.new(0, iconSz, 0, iconSz)
	coinImg.Position       = UDim2.new(0.5, -iconSz/2, 0, coinOffY)
	coinImg.BackgroundTransparency = 1
	coinImg.Image          = COIN_IMAGE_ID
	coinImg.ScaleType      = Enum.ScaleType.Fit

	-- Teks "xN" — kiri bawah
	local rewardTxt        = Instance.new("TextLabel", card)
	rewardTxt.Size         = UDim2.new(0, w - badgeSz - 10, 0, rSz + 2)
	rewardTxt.Position     = UDim2.new(0, 5, 1, -(rSz + 6))
	rewardTxt.BackgroundTransparency = 1
	rewardTxt.Text         = "x"..DAILY_REWARDS[dayIndex]
	rewardTxt.TextColor3   = Color3.fromRGB(40, 25, 5)
	rewardTxt.TextSize     = rSz
	rewardTxt.Font         = Enum.Font.GothamBold
	rewardTxt.TextXAlignment = Enum.TextXAlignment.Left --default left

	-- Ceklis — kanan bawah
