local countdownThread = nil -- track coroutine countdown

local function stopCountdown()
	if countdownThread and countdownThread ~= coroutine.running() then
		task.cancel(countdownThread)
	end
	countdownThread = nil
end

local function startCountdown(lastLoginTime)
	stopCountdown() -- stop countdown lama kalau ada

	countdownThread = task.spawn(function()
		while true do
			local elapsed   = os.time() - lastLoginTime
			local remaining = RESET_SECONDS - elapsed -- RESET_SECONDS dari server = 86400

			if remaining <= 0 then
				-- Waktunya habis, tombol bisa klaim lagi
				claimBtn.Active           = true
				claimBtn.BackgroundColor3 = CARD_ACT_HDR
				claimBtn.Text             = "Klaim Reward"
				btnStroke.Color           = GOLD_BRIGHT
				stopCountdown()
				break
			end

			local jam    = math.floor(remaining / 3600)
			local menit  = math.floor((remaining % 3600) / 60)
			local detik  = remaining % 60

			claimBtn.Text = string.format(
				"✓ Sudah Diklaim, Tunggu %d Jam %d Menit %d Detik",
				jam, menit, detik
			)

			task.wait(1)
		end
	end)
end



-- ============================================================
-- Update warna & icon kartu
-- ============================================================
local function setCardState(info, state)
	local card   = info.card
	local hdr    = info.hdr
	local hPatch = info.hPatch
	local stroke = info.stroke
	local check  = info.check
	local lock   = info.lock

	check.Visible = false
	lock.Visible  = false

	if state == "done" then
		card.BackgroundColor3   = CARD_DONE_BG
		hdr.BackgroundColor3    = CARD_DONE_HDR
		hPatch.BackgroundColor3 = CARD_DONE_HDR
		stroke.Color            = Color3.fromRGB(80, 180, 80)
		stroke.Thickness        = 1.5
		check.Visible           = true

	elseif state == "active" then
		card.BackgroundColor3   = CARD_ACT_BG
		hdr.BackgroundColor3    = CARD_ACT_HDR
		hPatch.BackgroundColor3 = CARD_ACT_HDR
		stroke.Color            = CARD_ACT_HDR
		stroke.Thickness        = 2.5

	else -- "locked"
		card.BackgroundColor3   = CARD_BG
		hdr.BackgroundColor3    = PURPLE_MID
		hPatch.BackgroundColor3 = PURPLE_MID
		stroke.Color            = GOLD_DARK
		stroke.Thickness        = 1.5
		lock.Visible            = true
	end
end

local function updateDayCards(currentDay, canClaim)
	for i, info in ipairs(dayCards) do
		if i < currentDay then
			setCardState(info, "done")
		elseif i == currentDay then
			setCardState(info, canClaim and "active" or "done")
		else
			setCardState(info, "locked")
		end
	end
end

