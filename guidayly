	lockImg.BackgroundTransparency = 1
	lockImg.Image          = LOCK_IMAGE_ID
	lockImg.ScaleType      = Enum.ScaleType.Fit
	lockImg.ZIndex         = 5
	lockImg.Visible        = false

	dayCards[dayIndex] = {
		card   = card,
		stroke = cardS,
		hdr    = hdr,
		hPatch = hPatch,
		check  = checkImg,
		lock   = lockImg,
	}
end

