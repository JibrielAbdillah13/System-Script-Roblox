-- ServerScriptService/TerlaSystems/Checkpoints/CheckpointService

local Players = game:GetService("Players")
local ServerStorage = game:GetService("ServerStorage")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local HttpService = game:GetService("HttpService")

Players.CharacterAutoLoads = false

local CheckpointConfig = require(ServerStorage.TerlaModules:WaitForChild("CheckpointConfig"))
local ProfileManager = require(ServerStorage.TerlaModules:WaitForChild("ProfileStoreManager"))

pcall(function()
	if typeof(CheckpointConfig.RespawnTime) == "number" then
		Players.RespawnTime = CheckpointConfig.RespawnTime
	end
end)

local function debugPrint(...)
	if CheckpointConfig.EnableDebug then
		print("[CheckpointService]", ...)
	end
end

local function getOrCreateRE(name)
	local ev = ReplicatedStorage:FindFirstChild(name)
	if not ev then
		ev = Instance.new("RemoteEvent")
		ev.Name = name
		ev.Parent = ReplicatedStorage
	end
	return ev
end

local function getOrCreateRF(name)
	local rf = ReplicatedStorage:FindFirstChild(name)
	if not rf then
		rf = Instance.new("RemoteFunction")
		rf.Name = name
		rf.Parent = ReplicatedStorage
	end
	return rf
end

local DropAckRE = getOrCreateRE("CP_DropAck")
local DropEvent = getOrCreateRE("CP_DropToStart")
local MarkVisitedRE = getOrCreateRE("CP_MarkVisited")
local ResetVisitedRE = getOrCreateRE("CP_ResetVisited")
local SkipDeniedRE = getOrCreateRE("CP_SkipDenied")
local SyncStateRE = getOrCreateRE("CP_SyncState")
local CustomMessageRE = getOrCreateRE("CP_CustomMessage")
