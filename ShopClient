-- Format angka: 1250 → "1.250"
local function formatNum(n)
	return tostring(n):reverse():gsub("(%d%d%d)", "%1."):reverse():gsub("^%.", "")
end

local function corner(r, p)
	local c = Instance.new("UICorner")
	c.CornerRadius = UDim.new(0, r)
	c.Parent = p
end

-- === Notifikasi ===
local function processNotif()
	if notifBusy or #notifQueue == 0 then return end
	notifBusy = true
	local entry = table.remove(notifQueue, 1)
	notifRef.BackgroundColor3 = entry.ok and C.Green or C.Red
	notifLblRef.Text = entry.msg
	notifRef.Visible = true
	notifRef.Position = UDim2.new(0.5, 0, 0, -50)
	TweenService:Create(notifRef, TweenInfo.new(0.25), {
		Position = UDim2.new(0.5, 0, 0, 12)
	}):Play()
	task.wait(2)
	TweenService:Create(notifRef, TweenInfo.new(0.18), {
		Position = UDim2.new(0.5, 0, 0, -50)
	}):Play()
	task.wait(0.2)
	notifRef.Visible = false
	notifBusy = false
	processNotif()
end

local function showNotif(msg, ok)
	table.insert(notifQueue, { msg = msg, ok = ok })
	task.spawn(processNotif)
end

-- === Bangun GUI ===
local function buildGui()
	local sg = Instance.new("ScreenGui")
	sg.Name = "ShopGui"
	sg.ResetOnSpawn = false
	sg.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	sg.Parent = playerGui

	-- ============================================================
	-- SCALING — auto resize berdasarkan layar
	-- ============================================================
	local uiScale = sg:FindFirstChildOfClass("UIScale") or Instance.new("UIScale", sg)

	-- resolusi dasar
	local baseX, baseY = 1366, 768

	-- fungsi update scale
	local function updateScale()
		local screenSize = workspace.CurrentCamera.ViewportSize
		local scaleX = screenSize.X / baseX
		local scaleY = screenSize.Y / baseY
		local scale = math.min(scaleX, scaleY)

		-- logika scaling
		if scale < 0.5 then
			-- layar sangat kecil (HP kecil) → perbesar agar tidak terlalu kecil
			uiScale.Scale = scale * 1.4
		elseif scale < 0.8 then
			-- layar kecil-sedang (HP biasa) → tingkatkan sedikit
			uiScale.Scale = scale * 1.2
		elseif scale < 1 then
			-- layar mendekati base → scaling minimal
			uiScale.Scale = scale * 1.05
		elseif scale > 1 then
			-- layar lebih besar dari base → PERKECIL
			uiScale.Scale = scale * 0.85
		else
			-- tepat di ukuran base
			uiScale.Scale = 1
		end
	end

	-- panggil pertama kali
	updateScale()

	-- update ketika layar berubah ukuran (rotate hp, resize window, dll)
	workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale)

	-- Notif toast
	local notif = Instance.new("Frame")
