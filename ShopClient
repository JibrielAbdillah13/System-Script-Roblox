	sPad.Parent = scroll

	return panel, scroll, coinLbl, notif, notifLbl, closeBtn
end

-- === Bikin kartu item ===
local function buildCard(parent, item, owned)
	local card = Instance.new("Frame")
	card.Name = "Card_" .. item.id
	card.BackgroundColor3 = owned and C.CardOwn or C.Card
	card.Transparency = 0.2
	card.LayoutOrder = item.id
	card.ZIndex = 8
	card.Parent = parent
	corner(10, card)

	-- Nama item
	local nameLbl = Instance.new("TextLabel")
	nameLbl.Size = UDim2.new(1, -16, 0, 22)
	nameLbl.Position = UDim2.new(0, 8, 0, 14)
	nameLbl.BackgroundTransparency = 1
	nameLbl.Text = item.name
	nameLbl.TextColor3 = C.White
	nameLbl.Font = Enum.Font.GothamBold
	nameLbl.TextSize = 13
	nameLbl.TextTruncate = Enum.TextTruncate.AtEnd
	nameLbl.ZIndex = 9
	nameLbl.Parent = card

	-- Tombol beli / status
	local btn = Instance.new("TextButton")
	btn.Name = "BuyBtn"
	btn.Size = UDim2.new(1, -16, 0, 28)
	btn.Position = UDim2.new(0, 8, 1, -40)
	btn.Font = Enum.Font.GothamBold
	btn.TextSize = 12
	btn.ZIndex = 9
	btn.Parent = card
	corner(6, btn)

	if owned then
		btn.BackgroundColor3 = C.GreenDim
		btn.TextColor3 = Color3.fromRGB(140, 200, 140)
		btn.Text = "Dimiliki"
		btn.AutoButtonColor = false
	else
		btn.BackgroundColor3 = C.Green
		btn.TextColor3 = Color3.fromRGB(0, 0, 0)
		btn.Text = formatNum(item.price)
		btn.MouseButton1Click:Connect(function()
			BuyRemote:FireServer(item.id)
		end)
	end
end

-- === Refresh seluruh kartu ===
local function refreshCards()
	for _, v in ipairs(scrollRef:GetChildren()) do
		if v:IsA("Frame") then v:Destroy() end
	end
	for _, item in ipairs(shopItems) do
		buildCard(scrollRef, item, ownedItems[item.toolName] == true)
	end
	coinLblRef.Text = formatNum(currentCoins)
end

-- === Buka / Tutup ===
local function openShop()
	if isOpen then return end
	isOpen = true
	local data = ShopDataRemote:InvokeServer()
	currentCoins = data.coins
	ownedItems   = data.owned
	shopItems    = data.items
	panelRef.Size = UDim2.new(0, 440, 0, 0)
	panelRef.Visible = true
	TweenService:Create(panelRef, TweenInfo.new(0.28, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
		Size = UDim2.new(0, 440, 0, 430)
	}):Play()
	refreshCards()
end

local function closeShop()
	if not isOpen then return end
	TweenService:Create(panelRef, TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
		Size = UDim2.new(0, 440, 0, 0)
	}):Play()
	task.wait(0.17)
	panelRef.Visible = false
	isOpen = false
end

-- === Init ===
local panel, scroll, coinLbl, notif, notifLbl, closeBtn = buildGui()
panelRef    = panel
scrollRef   = scroll
coinLblRef  = coinLbl
notifRef    = notif
notifLblRef = notifLbl

closeBtn.MouseButton1Click:Connect(closeShop)
OpenShopRemote.OnClientEvent:Connect(openShop)

BuyRemote.OnClientEvent:Connect(function(result)
	if result.success then
		currentCoins = result.coins
		ownedItems[result.toolName] = true
		showNotif(result.msg, true)
	else
		showNotif(result.msg, false)
	end
	refreshCards()
end)

CoinRemote.OnClientEvent:Connect(function(coins)
	currentCoins = coins
	coinLblRef.Text = formatNum(currentCoins)
end)

print("[ShopClient] Aktif!")
